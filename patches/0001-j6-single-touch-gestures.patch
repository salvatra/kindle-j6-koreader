+// Recorded gestures explicitly opt a single-touch remote into the gesture path.
+// BTN_TOUCH alone must still work as a normal button on other remotes.
+fn touch_gesture_mode(direct: bool, multitouch: bool, touch_button: bool,
+    absolute_xy: bool, configured: bool) -> bool {
+    direct || multitouch || (configured && touch_button && absolute_xy)
