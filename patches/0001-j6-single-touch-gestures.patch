+use super::*;
+
+#[test]
+fn j6_recorded_gestures_work_without_panel_properties() {
+    // Observed Kindle properties=0, ABS_X/Y, BTN_TOUCH; E20 gesture bindings exist.
+    assert!(touch_gesture_mode(false, false, true, true, true));
+}
+
+#[test]
+fn ordinary_centre_button_and_unconfigured_remotes_keep_key_handling() {
+    assert!(!touch_gesture_mode(false, false, true, true, false));
+    assert!(!touch_gesture_mode(false, false, true, false, true));
+    assert!(!touch_gesture_mode(false, false, false, true, true));
+    assert!(touch_gesture_mode(true, false, true, true, false));
+    assert!(touch_gesture_mode(false, true, true, false, false));
+    // Changing the configured bindings switches the decision without a reconnect.
+    assert!(touch_gesture_mode(false, false, true, true, true));
+    assert!(!touch_gesture_mode(false, false, true, true, false));
+}
+
+#[test]
+fn six_recorded_presses_match_only_on_completed_release() {
+    let cfg = config::Config::load(concat!(env!("CARGO_MANIFEST_DIR"),
+        "/fixtures/e20-kindlemappings.ini")).unwrap();
+    let touch = touch_gesture_mode(false, false, true, true, true);
+    let mut stroke = gesture::Stroke::default();
+    let mut matched = Vec::new();
+    let ranges = HashMap::from([(0u16, (500, 500)), (1u16, (500, 500))]);
+    for line in include_str!("../fixtures/e03-abs-xy-events.txt").lines() {
+        let v: Vec<i32> = line.split_whitespace().map(|x| x.parse().unwrap()).collect();
+        let before = matched.len();
+        if touch {
+            match (v[0], v[1], v[2]) {
+                (1, 330, 1) => stroke.press(),
+                (1, 330, 0) => {
+                    if let Some(path) = stroke.release() {
+                        if gesture::travel(&path) >= cfg.gesture_min_percent as f32 {
+                            let (name, distance) = gesture::nearest(&path, &cfg.gesture_templates).unwrap();
+                            assert!(distance <= cfg.gesture_tolerance, "{name}: {distance}");
+                            matched.push(name.to_owned());
+                        }
+                    }
+                },
+                (3, code @ (0 | 1), value) =>
+                    stroke.axis(code == 0, stick_percent(&ranges, code as u16, value)),
+                (0, 0, _) => stroke.sync(),
+                _ => {},
+            }
+        }
+        if v != [1, 330, 0] { assert_eq!(matched.len(), before); }
+    }
+    assert_eq!(matched, ["j6_left", "j6_left", "j6_left",
+        "j6_right", "j6_right", "j6_right"]);
+    // Synthetic negative control: stationary contact is not a directional swipe.
+    stroke.press(); stroke.axis(true, 0); stroke.axis(false, 0); stroke.sync();
+    assert!(gesture::travel(&stroke.release().unwrap()) < cfg.gesture_min_percent as f32);
+    assert!(stroke.release().is_none());
+}
